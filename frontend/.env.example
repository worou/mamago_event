# ⚠️ Vite inline TOUTE variable VITE_* en clair dans le bundle JavaScript.
# Ce fichier ne doit donc contenir que des valeurs publiques.
#
# En particulier, aucune clé Stripe n'a sa place ici :
#   - la clé secrète (sk_…) se configure dans l'administration MamaGo,
#     Payment Methods → Stripe. Elle ne doit jamais quitter le serveur.
#   - la clé publiable (pk_…) serait inutile : le paiement est traité par
#     la page hébergée du backend, ce frontend n'intègre pas Stripe.js.

# URL de base de l'API MamaGo
VITE_API_BASE_URL=https://frstore.mamagoapps.com

# En-têtes plateforme (multi-module 6amMart). moduleId = module "events".
VITE_MODULE_ID=1
VITE_ZONE_ID=[1]

